# The brew version is old, so I install it via [corepack](https://pnpm.io/installation#using-corepack), but I want to keep the brew line here for documentation purposes.
# brew "pnpm"

# The minimal, blazing-fast, and infinitely customizable prompt for any shell!
brew "starship"

# zoxide is a smarter cd command, inspired by z and autojump.
brew "zoxide"

brew "neovim"
brew "p7zip"

# Command-line fuzzy finder written in Go
brew "fzf"
# Television is a fast, portable fuzzy finder for the terminal. https://github.com/alexpasmantier/television
brew "television"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Simple, fast and user-friendly alternative to find - https://github.com/sharkdp/fd
brew "fd"
# Replaces LS - https://the.exa.website/ NO LONGER MAINTAINED
# brew "exa"
# The next gen ls command
brew "lsd"
# Simplified and community-driven man pages - https://github.com/tldr-pages/tldr
brew "tldr"
# ripgrep combines the usability of The Silver Searcher with the raw speed of grep - https://github.com/BurntSushi/ripgrep
brew "ripgrep"
# Programatically correct mistyped console commands
brew "thefuck"
# A syntax-highlighting pager for git - https://github.com/dandavison/delta
brew "git-delta"
# Review diffs, files, and documents right in your terminal
brew "umputun/apps/revdiff"
# Difftastic is a structural diff tool that understands syntax. It supports over 30 programming languages and when it works, it's fantastic. - https://github.com/wilfred/difftastic
# https://github.com/Wilfred/difftastic
brew "difftastic"
# Wrapper to colorize and simplify ping's output
brew "prettyping"
# Improved top (interactive process viewer)
brew "htop"
# The cmatrix command is based off the digital rain animation from the opening scenes of Matrix movie series.
# I use it mostly for a cool clear replacement command
brew "cmatrix"
# du + rust = dust. Like du but more intuitive. (folder size)
brew "dust"
# mprocs runs multiple commands in parallel and shows output of each command separately. https://github.com/pvolok/mprocs
brew "mprocs"
# Custom local domain aliases for local dev servers
brew "peterldowns/tap/localias"
# An extremely fast Python package and project manager, written in Rust.
# This will be installed via mise
# brew "uv"
# A universal document converter, that can convert between a huge number of formats. https://pandoc.org/
# I use this in Obsidian so it needs to be in the main path.
brew "pandoc"
# A better whois and domain intelligence toolkit. Interactive TUI with tabbed views for WHOIS, DNS, mail, SSL/TLS, HTTP headers, SEO analysis, and tech stack detection.
brew "quien"

# Atuin replaces your existing shell history with a SQLite database, and records additional context for your commands.
brew "atuin"
