# wifi-password: Print the password for the current (or specified) Wi-Fi network.
# Usage: wifi-password [ssid]
# Works on macOS, Linux (NetworkManager), and Windows (WSL/Git Bash via netsh).
# TODO: This doesn't work yet

function wifi-password() {
    local os_name="$(uname -s)"
    local ssid password

    case "$os_name" in
        Darwin*)
            # macOS
            # Prompt user for Wi-Fi SSID
            print -n "Enter Wi-Fi name (SSID): "
            read ssid

            if [ -z "$ssid" ]; then
                echo "SSID cannot be empty." && return 1
            fi

            echo "SSID: $ssid"

            # Retrieve the password from the Keychain
            # Note: macOS may trigger a graphical prompt asking for Keychain access.
            password=$(security find-generic-password -wa "$ssid" 2>/dev/null)
            ;;

        Linux*)
            # Linux
            # 1. Try iwgetid first, then fallback to nmcli
            if command -v iwgetid >/dev/null 2>&1; then
                ssid=$(iwgetid --raw)
            elif command -v nmcli >/dev/null 2>&1; then
                ssid=$(nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2)
            fi

            if [ -z "$ssid" ]; then
                echo "Could not find an active Wi-Fi connection." && return 1
            fi

            echo "SSID: $ssid"

            # 2. Extract password via nmcli (often works without sudo if user has permissions)
            if command -v nmcli >/dev/null 2>&1; then
                password=$(nmcli -s -g 802-11-wireless-security.psk connection show "$ssid" 2>/dev/null)
            fi

            # 3. Fallback: Read NetworkManager files directly (Requires sudo)
            if [ -z "$password" ]; then
                password=$(sudo grep -h -m 1 -E '^(psk|password)=' "/etc/NetworkManager/system-connections/$ssid" "/etc/NetworkManager/system-connections/$ssid.nmconnection" 2>/dev/null | cut -d= -f2)
            fi
            ;;

        CYGWIN*|MINGW*|MSYS*|Windows_NT*)
            # Windows (WSL, Git Bash, MSYS)
            local netsh_cmd="netsh"

            # Check if running under WSL/Bash where '.exe' extension is required
            command -v netsh.exe >/dev/null 2>&1 && netsh_cmd="netsh.exe"

            # 1. Get SSID
            ssid=$("$netsh_cmd" wlan show interface | grep -m 1 "^ *SSID" | sed 's/^ *SSID *: //;s/\r//')

            if [ -z "$ssid" ]; then
                echo "Not connected to a Wi-Fi network." && return 1
            fi

            echo "SSID: $ssid"

            # 2. Get cleartext key
            password=$("$netsh_cmd" wlan show profile name="$ssid" key=clear | grep -m 1 "Key Content" | sed 's/^ *Key Content *: //;s/\r//')
            ;;

        *)
            echo "Unsupported operating system: $os_name"
            return 1
            ;;
    esac

    # Output the result
    if [ -n "$password" ]; then
        echo "Password: $password"
    else
        echo "Could not extract password. You may need sudo/admin privileges, or the network has no password."
        return 1
    fi
}
